{
  "manifest_version": 3,
  "name": "NudgeKavach — NudgeProof",
  "version": "0.2.0",
  "description": "Local, evidence-first dark-pattern observations. Catalyst Hack 2026 MVP.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "action": {
    "default_title": "NudgeKavach",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["rules.js", "report.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
